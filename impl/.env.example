API_HOST=0.0.0.0
API_PORT=8080
# Cloud Run injects PORT=8080 automatically (overrides API_PORT)

# Local dev only: path to a `creds.config` file (User/Password/ZILLIZ_URI/
# GROQ_API_KEY/HF_TOKEN, one per line) to fill in the vars below. Optional —
# if unset, rag_core/common/config.py also auto-searches parent dirs for `creds.config`.
# Never set this in deployed environments; use real env vars / Secret Manager.
# CREDS_CONFIG_PATH=/absolute/path/to/creds.config

# Zilliz Cloud (Cluster -> Connect -> Public Endpoint). Required for /search /
# /index-all / /index-doc — no literal fallback, set these for real use.
ZILLIZ_URI=
ZILLIZ_USER=
ZILLIZ_PASSWORD=

# Hugging Face token (read/inference scope is enough). Required — embeddings
# are computed via the HF Inference API (see rag_core/common/embeddings.py) rather
# than a locally downloaded model, so no local model/torch download happens.
HF_TOKEN=

# Rerank (same defaults as sample/retrieval_config.py). After vector search,
# score candidates with this cross-encoder via the HF Inference API and keep
# the request's top_k. Set RERANK=false to return raw vector order.
# RERANK=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=8

# Optional overrides (defaults shown match playground/schema_design). This is
# the HF Hub model id called via the Inference API, not a local model path.
COLLECTION_NAME=rag_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional overrides for the source docs repo used by /index-all
# (defaults shown match AGENTS.md / playground/chunking). Not secrets — the
# source repo is public.
# GITHUB_SOURCE_REPO=harshkumar1/website-scrapper
# GITHUB_SOURCE_BRANCH=main
# GITHUB_SOURCE_DOCS_SUBDIR=data/markdown
# GITHUB_SOURCE_CSV_PATH=data/raw_data.csv

# Local dev only: if set, /index-all reads data/markdown + data/raw_data.csv
# from this local checkout of the source repo instead of fetching from
# GitHub (no network round trips, sees uncommitted local edits).
# SOURCE_LOCAL_DIR=/absolute/path/to/website-scrapper

# Groq (RAG "generate" stage — rag_core/retrieval/generation.py). Required
# only for /search calls with generate_answer=true (the default); retrieval
# alone (generate_answer=false) and /index-all / /index-doc don't need it.
GROQ_API_KEY=

# Optional overrides (defaults shown) for ops-level generation settings.
# Answer-QUALITY knobs (model, temperature, max_tokens, reasoning_format,
# system/user prompts) are NOT env vars — they live in generation_config.json
# (see that file + impl/README.MD) and are re-read on every request, so they
# can be tuned live without restarting/rebuilding the container.
# GENERATION_TIMEOUT_SECONDS=30
# MAX_CONCURRENT_GENERATIONS=4

# Local dev only: path to generation_config.json if not using the default
# next to server.py (mirrors CREDS_CONFIG_PATH above). In Docker, prefer
# bind-mounting your own file over /app/generation_config.json instead of
# setting this.
# GENERATION_CONFIG_PATH=/absolute/path/to/generation_config.json
